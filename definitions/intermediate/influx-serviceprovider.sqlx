config {
  type: "view",
  name: "influx-sp",
  description: "View with distinct service providers and assigned IDs."
}

WITH raw_sps AS (
  SELECT DISTINCT sp_id AS sp
  FROM ${ref("fetched-influx-logs")}
  WHERE sp_id IS NOT NULL
),

sp_with_id AS (
  SELECT
    raw.sp,
    dw.sp_id
  FROM raw_sps raw
  LEFT JOIN ${ref("dim_serviceprovider")} dw
    ON raw.sp = dw.sp
),

sp_final AS (
  SELECT
    sp,
    COALESCE(
      sp_id,
      ROW_NUMBER() OVER (ORDER BY sp)
        + COALESCE((SELECT MAX(sp_id) FROM ${ref("dim_serviceprovider")}), 0)
    ) AS sp_id
  FROM sp_with_id
)

SELECT
  sp_id,
  sp
FROM sp_final
