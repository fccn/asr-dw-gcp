config {
  type: "table",
  name: "fact_es_distinct_user_hit",
  schema: "data_warehouse",
  description: "Individual user hits from ES logs with dimension IDs - ES-specific intermediate table.",
  bigquery: {
    partitionBy: "full_date",
    clusterBy: ["auth_status", "institution_id"]
  },
  tags: ["eduroam"]
}

WITH filtered_es_logs AS (
  SELECT
    full_date,
    domain,
    radius,
    nas,
    user_hash,
    auth_status
  FROM ${ref("fetched-es-logs")}
  WHERE domain IS NOT NULL
    AND auth_status = 'OK'
),
eduroam_institutions AS (
  SELECT 
    MIN(institution_id) as institution_id,  -- Take first match to avoid duplicates
    realm
  FROM ${ref("dim_institution")}
  WHERE service_id = 1  -- Pre-filter institutions
  GROUP BY realm  -- Deduplicate by realm
)

SELECT
  src.full_date,
  COALESCE(institution.institution_id, -1) AS institution_id,
  COALESCE(radius_dim.radius_id, -1) AS radius_id,
  COALESCE(nas_dim.nas_id, -1) AS nas_id,
  src.user_hash,
  src.auth_status
  
FROM filtered_es_logs src
LEFT JOIN eduroam_institutions institution 
  ON src.domain = institution.realm
LEFT JOIN ${ref("dim_radius")} radius_dim 
  ON src.radius = radius_dim.radius  
LEFT JOIN ${ref("dim_nas")} nas_dim 
  ON src.nas = nas_dim.nas