config {
  type: "table",
  name: "updated-data-metrics",
  description: "View simplificada focada na métrica 4 (distinct user hits), com estrutura preparada para futuras expansões.",
  bigquery: {
    partitionBy: "full_date",
    clusterBy: ["metric_id"]
  }
}

SELECT
  dm.full_date,
  dm.service_id,
  dm.institution_id,
  dm.radius_id,
  dm.nas_id,
  dm.idp_id,
  dm.sp_id,
  dm.metric_id,

  -- Valor da métrica (neste momento só usamos distinct hit count (4) )
  CASE
    WHEN dm.metric_id = 4 THEN dm.value

    -- === Futuras métricas===
    -- WHEN dm.metric_id = X THEN 

    ELSE NULL
  END AS value

FROM
  ${ref("data-metrics")} dm
