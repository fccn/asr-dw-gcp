config {
  type: "view",
  name: "es-institutions-staging",
  description: "Extract institution data from ES logs."
}
SELECT DISTINCT
  domain AS realm,
  domain AS codename,  -- Use domain as codename
  'From ES logs' AS description,
  FALSE AS member,  -- Default to false for ES-discovered institutions
  domain AS idp_identifier  -- Will map to dim_identityprovider.idp later
FROM ${ref("fetched-es-logs")}
WHERE domain IS NOT NULL 
  AND auth_status = 'OK'