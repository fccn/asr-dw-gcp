config {
  type: "view",
  name: "es-institutions-staging",
  description: "Extract institution data from ES logs.",
  tags: ["eduroam"]
}
SELECT DISTINCT
  domain AS realm,
  domain AS codename,
  'From ES logs' AS description,
  FALSE AS member,
  domain AS idp_identifier
FROM ${ref("fetched-es-logs")}
WHERE domain IS NOT NULL 
  AND auth_status = 'OK'