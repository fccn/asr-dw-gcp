config { type: "operations" }

MERGE INTO
  ${ref("dim_identityprovider")} AS target
USING (
  SELECT * FROM ${ref("influx-idp")} WHERE idp_id IS NOT NULL
) AS source
ON
  target.idp = source.idp
WHEN NOT MATCHED THEN
  INSERT (idp_id, idp, status)
  VALUES (source.idp_id, source.idp, source.status)