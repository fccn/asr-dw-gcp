config {
  type: "table",
  name: "dim_date",
  schema: "data_warehouse",
  description: "Date dimension from all log sources.",
  tags: ["eduroam", "rctsaai", "cid"]
}

-- ES logs dates
SELECT DISTINCT
  full_date,
  EXTRACT(DAY FROM full_date) AS day,
  EXTRACT(MONTH FROM full_date) AS month,
  EXTRACT(YEAR FROM full_date) AS year,
  EXTRACT(QUARTER FROM full_date) AS quarter,
  EXTRACT(WEEK FROM full_date) AS week,
  EXTRACT(DAYOFWEEK FROM full_date) AS weekday
FROM ${ref("fetched-es-logs")}
WHERE full_date IS NOT NULL

UNION DISTINCT

-- InfluxDB dates  
SELECT DISTINCT
  full_date,
  EXTRACT(DAY FROM full_date) AS day,
  EXTRACT(MONTH FROM full_date) AS month,
  EXTRACT(YEAR FROM full_date) AS year,
  EXTRACT(QUARTER FROM full_date) AS quarter,
  EXTRACT(WEEK FROM full_date) AS week,
  EXTRACT(DAYOFWEEK FROM full_date) AS weekday
FROM ${ref("fetched-influx-logs")}
WHERE full_date IS NOT NULL

UNION DISTINCT

-- CIÊNCIA-ID dates
SELECT DISTINCT
  full_date,
  EXTRACT(DAY FROM full_date) AS day,
  EXTRACT(MONTH FROM full_date) AS month,
  EXTRACT(YEAR FROM full_date) AS year,
  EXTRACT(QUARTER FROM full_date) AS quarter,
  EXTRACT(WEEK FROM full_date) AS week,
  EXTRACT(DAYOFWEEK FROM full_date) AS weekday
FROM ${ref("fetched-ciencia-id-logs")}
WHERE full_date IS NOT NULL