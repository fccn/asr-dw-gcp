config {
    type: "table",
    name: "dim_institution",
    schema: "data_warehouse",
    description: "Institution dimension from all services (IDP and SP), updates on data change.",
    bigquery: {
        clusterBy: ["service_id"]
    },
    tags: ["webhook"]
}

WITH
  all_institutions AS (
    -- Eduroam institutions
  SELECT
    CONCAT(codename, '_', '1') AS institution_key,
    -- Unique id across services
    codename,
    description,
    realm,
    member,
    CAST(NULL AS STRING) AS ORGANIZATION,
    CAST(NULL AS DATE) AS date_activated,
    CAST(NULL AS DATE) AS date_cancelled,
    CASE
      WHEN status = 'Ativo' THEN TRUE
      ELSE FALSE
  END
    AS active,
    1 AS service_id,
    'eduroam' AS service_name
  FROM
    ${ref("fetched-webhook-eduroam")}
  UNION ALL
    -- RCTSAAI institutions (from both IDP and SP)
  SELECT
    DISTINCT CONCAT(institution_codename, '_', '2') AS institution_key,
    institution_codename AS codename,
    institution_description AS description,
    institution_codename AS realm,
    CAST(NULL AS BOOLEAN) AS member,
    CAST(NULL AS STRING) AS ORGANIZATION,
    institution_date_activated AS date_activated,
    CAST(NULL AS DATE) AS date_cancelled,
    CASE
      WHEN institution_status = 'Ativo' THEN TRUE
      ELSE FALSE
  END
    AS active,
    2 AS service_id,
    'rctsaai' AS service_name
  FROM (
    SELECT
      institution_codename,
      institution_description,
      institution_status,
      institution_date_activated
    FROM
      ${ref("fetched-webhook-rctsaai-idp")}
    UNION ALL
    SELECT
      institution_codename,
      institution_description,
      institution_status,
      institution_date_activated
    FROM
      ${ref("fetched-webhook-rctsaai-sp")} )
  WHERE
    institution_codename IS NOT NULL
    AND TRIM(institution_codename) != ''
    AND TRIM(institution_codename) != ''
  UNION ALL
    -- CIÊNCIA-ID institutions (from both IDP and SP)
  SELECT
    DISTINCT CONCAT(institution_codename, '_', '3') AS institution_key,
    institution_codename AS codename,
    institution_description AS description,
    institution_codename AS realm,
    CAST(NULL AS BOOLEAN) AS member,
    CAST(NULL AS STRING) AS ORGANIZATION,
    institution_date_activated AS date_activated,
    CAST(NULL AS DATE) AS date_cancelled,
    CASE
      WHEN institution_status = 'Ativo' THEN TRUE
      ELSE FALSE
  END
    AS active,
    3 AS service_id,
    'ciencia_id' AS service_name
  FROM (
    SELECT
      institution_codename,
      institution_description,
      institution_status,
      institution_date_activated
    FROM
      ${ref("fetched-webhook-cid-idp")}
    UNION ALL
    SELECT
      institution_codename,
      institution_description,
      institution_status,
      institution_date_activated
    FROM
      ${ref("fetched-webhook-cid-sp")} )
  WHERE
    institution_codename IS NOT NULL ),
  with_ids AS (
  SELECT
    institution_key,
    codename,
    description,
    realm,
    member,
    ORGANIZATION,
    date_activated,
    date_cancelled,
    active,
    service_id,
    service_name,
    ROW_NUMBER() OVER (ORDER BY institution_key) AS institution_id
  FROM
    all_institutions )
SELECT
  institution_id,
  institution_key,
  codename,
  description,
  realm,
  member,
  ORGANIZATION,
  date_activated,
  date_cancelled,
  active,
  service_id,
  service_name
FROM
  with_ids
