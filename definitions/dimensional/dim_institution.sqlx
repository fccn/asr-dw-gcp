config {
  type: "table",
  name: "dim_institution",
  schema: "data_warehouse",
  description: "Institution dimension from all services, updates on data change.",
  bigquery: {
    clusterBy: ["service_id"]
  },
  tags: ["webhook"]
}

WITH all_institutions AS (
  -- Eduroam institutions
  SELECT
    CONCAT(codename, '_', '1') as institution_key,  -- Unique id across services
    codename,
    description,
    realm,
    member,
    CAST(NULL AS STRING) as organization,
    CAST(NULL AS DATE) as date_activated,
    CAST(NULL AS DATE) as date_cancelled,
    CASE WHEN status = 'Ativo' THEN TRUE ELSE FALSE END as active,
    1 as service_id,
    'eduroam' as service_name
  FROM ${ref("fetched-webhook-eduroam")}
  
  UNION ALL
  
  -- RCTSAAI institutions
  SELECT DISTINCT
    CONCAT(institution_codename, '_', '2') as institution_key,
    institution_codename as codename,
    institution_description as description,
    institution_codename as realm,
    CAST(NULL AS BOOLEAN) as member,
    CAST(NULL AS STRING) as organization,
    institution_date_activated as date_activated,
    CAST(NULL AS DATE) as date_cancelled,
    CASE WHEN institution_status = 'Ativo' THEN TRUE ELSE FALSE END as active,
    2 as service_id,
    'rctsaai' as service_name
  FROM ${ref("fetched-webhook-rctsaai-idp")}
  WHERE institution_codename IS NOT NULL
  
  UNION ALL
  
  -- CIÊNCIA-ID institutions
  SELECT DISTINCT
    CONCAT(institution_codename, '_', '3') as institution_key,
    institution_codename as codename,
    institution_description as description,
    institution_codename as realm,
    CAST(NULL AS BOOLEAN) as member,
    CAST(NULL AS STRING) as organization,
    institution_date_activated as date_activated,
    CAST(NULL AS DATE) as date_cancelled,
    CASE WHEN institution_status = 'Ativo' THEN TRUE ELSE FALSE END as active,
    3 as service_id,
    'ciencia_id' as service_name
  FROM ${ref("fetched-webhook-cid-idp")}
  WHERE institution_codename IS NOT NULL
),
with_ids AS (
  SELECT
    institution_key,
    codename,
    description,
    realm,
    member,
    organization,
    date_activated,
    date_cancelled,
    active,
    service_id,
    service_name,
    ROW_NUMBER() OVER (ORDER BY institution_key) AS institution_id
  FROM all_institutions
)
SELECT
  institution_id,
  institution_key,
  codename,
  description,
  realm,
  member,
  organization,
  date_activated,
  date_cancelled,
  active,
  service_id,
  service_name
FROM with_ids