config {
  type: "incremental",
  schema: "data_warehouse",
  name: "fact_data_metric",
  description: "Final metrics table - ES via intermediate, InfluxDB + CIÊNCIA-ID direct.",
  bigquery: {
    partitionBy: "full_date",
    clusterBy: ["service_id", "metric_id"]
  },
  tags: ["eduroam", "rctsaai", "cid"]
}

-- === Elasticsearch Metrics (via intermediate table) ===
WITH es_metrics AS (
  -- Metric 4: Distinct Hits
  SELECT
    duh.full_date,
    1 AS service_id,  -- Eduroam
    duh.institution_id,
    duh.radius_id,
    duh.nas_id,
    CAST(-1 AS INT64) AS idp_id,  -- Eduroam doesn't have IDPs
    CAST(-1 AS INT64) AS sp_id,   -- Eduroam doesn't have SPs
    4 AS metric_id,
    COUNT(DISTINCT duh.user_hash) AS metric_value
  FROM ${ref("fact_es_distinct_user_hit")} duh
  ${ when(incremental(), `WHERE duh.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
  GROUP BY 1,2,3,4,5,6,7,8
  
  UNION ALL
  
  -- Metric 1: Total Hits
  SELECT
    duh.full_date,
    1 AS service_id,  -- Eduroam
    duh.institution_id,
    duh.radius_id,
    duh.nas_id,
    CAST(-1 AS INT64) AS idp_id,
    CAST(-1 AS INT64) AS sp_id,
    1 AS metric_id,
    COUNT(*) AS metric_value
  FROM ${ref("fact_es_distinct_user_hit")} duh
  ${ when(incremental(), `WHERE duh.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
  GROUP BY 1,2,3,4,5,6,7,8
),

-- === RCTSAAI Metrics ===
rctsaai_metrics AS (
  -- Metric 4: Distinct Hits
  SELECT
    f.full_date,
    2 AS service_id,  -- RCTSAAI
    COALESCE(institution.institution_id, -1) AS institution_id,
    CAST(-1 AS INT64) AS radius_id,  -- RCTSAAI doesn't have RADIUS
    CAST(-1 AS INT64) AS nas_id,     -- RCTSAAI doesn't have NAS
    COALESCE(idp_dim.idp_id, -1) AS idp_id,
    COALESCE(sp_dim.sp_id, -1) AS sp_id,
    4 AS metric_id,
    f.count_distinct_user_id AS metric_value
  FROM ${ref("fetched-influx-logs")} f
  LEFT JOIN ${ref("dim_identityprovider")} idp_dim 
    ON f.idp_id = idp_dim.idp 
    AND idp_dim.service_id = 2  -- RCTSAAI service
  LEFT JOIN ${ref("dim_serviceprovider")} sp_dim 
    ON f.sp_id = sp_dim.sp 
    AND sp_dim.service_id = 2   -- RCTSAAI service
  LEFT JOIN ${ref("dim_institution")} institution 
    ON idp_dim.institution_codename = institution.codename
    AND institution.service_id = 2  -- RCTSAAI institutions
  ${ when(incremental(), `WHERE f.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
  
  UNION ALL
  
  -- Metric 1: Total Hits
  SELECT
    f.full_date,
    2 AS service_id,  -- RCTSAAI
    COALESCE(institution.institution_id, -1) AS institution_id,
    CAST(-1 AS INT64) AS radius_id,
    CAST(-1 AS INT64) AS nas_id,
    COALESCE(idp_dim.idp_id, -1) AS idp_id,
    COALESCE(sp_dim.sp_id, -1) AS sp_id,
    1 AS metric_id,
    f.count_user_id AS metric_value
  FROM ${ref("fetched-influx-logs")} f
  LEFT JOIN ${ref("dim_identityprovider")} idp_dim 
    ON f.idp_id = idp_dim.idp 
    AND idp_dim.service_id = 2
  LEFT JOIN ${ref("dim_serviceprovider")} sp_dim 
    ON f.sp_id = sp_dim.sp 
    AND sp_dim.service_id = 2
  LEFT JOIN ${ref("dim_institution")} institution 
    ON idp_dim.institution_codename = institution.codename
    AND institution.service_id = 2
  ${ when(incremental(), `WHERE f.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
),

-- === CIÊNCIA-ID Metrics ===
ciencia_id_metrics AS (
  -- Metric 4: Distinct Hits
  SELECT
    f.full_date,
    3 AS service_id,  -- CIÊNCIA-ID
    COALESCE(institution.institution_id, -1) AS institution_id,
    CAST(-1 AS INT64) AS radius_id,  -- CIÊNCIA-ID doesn't have RADIUS
    CAST(-1 AS INT64) AS nas_id,     -- CIÊNCIA-ID doesn't have NAS
    COALESCE(idp_dim.idp_id, -1) AS idp_id,
    COALESCE(sp_dim.sp_id, -1) AS sp_id,
    4 AS metric_id,
    f.count_distinct_user_id AS metric_value
  FROM ${ref("fetched-ciencia-id-logs")} f
  LEFT JOIN ${ref("dim_identityprovider")} idp_dim 
    ON f.idp_id = idp_dim.idp 
    AND idp_dim.service_id = 3  -- CIÊNCIA-ID service
  LEFT JOIN ${ref("dim_serviceprovider")} sp_dim 
    ON f.sp_id = sp_dim.sp 
    AND sp_dim.service_id = 3   -- CIÊNCIA-ID service
  LEFT JOIN ${ref("dim_institution")} institution 
    ON idp_dim.institution_codename = institution.codename
    AND institution.service_id = 3  -- CIÊNCIA-ID institutions
  ${ when(incremental(), `WHERE f.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
  
  UNION ALL
  
  -- Metric 1: Total Hits
  SELECT
    f.full_date,
    3 AS service_id,  -- CIÊNCIA-ID
    COALESCE(institution.institution_id, -1) AS institution_id,
    CAST(-1 AS INT64) AS radius_id,
    CAST(-1 AS INT64) AS nas_id,
    COALESCE(idp_dim.idp_id, -1) AS idp_id,
    COALESCE(sp_dim.sp_id, -1) AS sp_id,
    1 AS metric_id,
    f.count_user_id AS metric_value
  FROM ${ref("fetched-ciencia-id-logs")} f
  LEFT JOIN ${ref("dim_identityprovider")} idp_dim 
    ON f.idp_id = idp_dim.idp 
    AND idp_dim.service_id = 3
  LEFT JOIN ${ref("dim_serviceprovider")} sp_dim 
    ON f.sp_id = sp_dim.sp 
    AND sp_dim.service_id = 3
  LEFT JOIN ${ref("dim_institution")} institution 
    ON idp_dim.institution_codename = institution.codename
    AND institution.service_id = 3
  ${ when(incremental(), `WHERE f.full_date > (SELECT MAX(full_date) FROM ${self()})`) }
),

-- === Combined Metrics ===
all_metrics AS (
  SELECT * FROM es_metrics
  UNION ALL  
  SELECT * FROM rctsaai_metrics
  UNION ALL
  SELECT * FROM ciencia_id_metrics
)

SELECT
  full_date,
  service_id,
  institution_id,
  radius_id, 
  nas_id,
  idp_id,
  sp_id,
  metric_id,
  CAST(metric_value AS FLOAT64) AS metric_value
FROM all_metrics
WHERE metric_value > 0
  AND institution_id != -1