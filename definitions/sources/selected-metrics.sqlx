config {
  type: "view",
  name: "selected-metrics",
  description: "View of selected metrics for the project - currently focused on metric 4.",
  tags: ["eduroam", "rctsaai"]
}
SELECT
  metric_id,
  name,
  units
FROM ${ref("dim_metric")}
WHERE name IN (
  'distinct hits',  -- Currently implemented (metric 4)
  'total hits' -- Currently implemented (metric 1)

  -- Future metrics to enable:
  -- ,'total ok hits' 
  -- ,'total fail hits'
  -- ,'distinct ok hits'
  -- ,'distinct fail hits'
)