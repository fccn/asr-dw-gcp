config {
    type: "view",
    name: "fetched-webhook-eduroam",
    description: "Eduroam institutions from reliable webhook staging data.",
    tags: ["webhook"]
}
WITH deduplicated AS (
    SELECT DISTINCT
        CI1_codename as codename,
        CI1_descricao AS description,
        CI1_org AS org,
        CI1_membro as member,
        NULL as idp,  -- Eduroam doesn't have direct IDP mapping like the old webhook
        CI1_status as status,
        STRING_AGG(DISTINCT Radius_Realms, '; ' ORDER BY Radius_Realms) as realm
    FROM ${ref("webhook_eduroam_info")}
    WHERE CI1_codename IS NOT NULL
    GROUP BY 1,2,3,4,5,6
),
ranked AS (
    SELECT
        codename,
        CASE 
            WHEN org IS NULL THEN description
            ELSE org
        END AS description,
        realm,
        member,
        idp,
        status,
        ROW_NUMBER() OVER (PARTITION BY codename ORDER BY codename) AS row_num
    FROM deduplicated
)
SELECT
    codename,
    description,
    realm,
    member,
    idp,
    status
FROM ranked
WHERE row_num = 1
